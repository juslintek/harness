{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/web/main.tsx",
    "scripts/*.ts",
    "src/**/*.test.ts",
    "conformance/**/*.test.ts",
    "conformance/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/*.ts", "conformance/**/*.ts"],
  "ignoreDependencies": [
    "lefthook",
