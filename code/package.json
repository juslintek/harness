{
  "name": "harness",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun test",
    "lint": "biome check .",
    "typecheck": "bun node_modules/typescript7/bin/tsc --noEmit -p .",
    "knip": "knip",
    "deps": "depcruise src",
    "dup": "jscpd",
    "size": "bun scripts/check-file-size.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run knip && bun run deps && bun run dup && bun run size"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "hono": "4.13.16",
    "preact": "11.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/bun": "1.4.4",
    "dependency-cruiser": "18.7.1",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@7.0.2"
  }
}
