#!/bin/sh
# Stand-in for the codex CLI. The login marker is auth.json in CODEX_HOME, as with the real CLI.
# Logged out is exit 1 with "Not logged in"; a missing CODEX_HOME is a config error, also exit 1.
echo "codex $* home=${CODEX_HOME-<unset>}" >> "${FAKE_BIN_LOG:-/dev/null}"
dir="${CODEX_HOME:-$FAKE_DEFAULT_HOME}"
marker="$dir/auth.json"
case "$1 $2" in
  "login status")
    if [ ! -d "$dir" ]; then echo "error: CODEX_HOME points to a missing directory" >&2; exit 1; fi
    if [ -f "$marker" ]; then
      echo "Logged in using ChatGPT"
      echo "Plan: $(cat "$marker")"
    else
      echo "Not logged in"
      exit 1
    fi ;;
  *)
    case "$1" in
      logout) rm -f "$marker"; echo "Logged out" ;;
      login) mkdir -p "$dir" && printf '%s' "${FAKE_LOGIN_HINT:-plus}" > "$marker"; echo "Login successful" ;;
      --version) echo "codex-cli 0.9.0" ;;
      *) echo "fake codex: unsupported: $*" >&2; exit 2 ;;
    esac ;;
esac
