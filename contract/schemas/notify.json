        },
        "path": {
          "format": "starts_with",
          "pattern": "^\\/.*",
          "type": "string"
        },
        "tag": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "orgId",
        "title",
        "body",
        "path",
        "tag"
      ],
      "type": "object"
    }
  },
